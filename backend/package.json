{
  "name": "@benki/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Benki core API: double-entry ledger on SQLite, AML/fraud risk engine, compliance case management, payments orchestration across agent, mobile money, bill, merchant and cross-border rails, and a back-office API. Sandbox providers only.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node22 --format=cjs --sourcemap --outfile=dist/server.js --external:express --external:cors --external:zod",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@benki/shared": "0.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.3",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
